# Copy to simulator/.env (git-ignored) and adjust. See docs/SIMULATOR.md.

# Dashboard the virtual phones send to. Local: http://localhost:3000. Deployed: the Vercel PRODUCTION URL.
TARGET_URL=http://localhost:3000

# Where the simulator's own control UI/API listens. Keep 127.0.0.1 unless you need other devices to reach it.
HOST=127.0.0.1
PORT=4545

# Required if HOST is 0.0.0.0 or you expose the simulator through a tunnel. Any username + this password.
SIM_PASSWORD=

# All phones share the laptop's IP. Keep this below the dashboard's REPORTS_PER_MINUTE (default 20).
MAX_REPORTS_PER_MINUTE=15

# How often phones check the dashboard for new alerts, and how close a phone must be to the zone to get one.
ALERT_POLL_SECONDS=10
ALERT_RADIUS_KM=30

# Phones created at startup, and driving speed multiplier for the evacuation scenario.
START_PHONES=3
TIME_SCALE=30
